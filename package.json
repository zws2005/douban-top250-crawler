{
  "name": "douban-top250-crawler",
  "version": "1.0.0",
  "private": true,
  "description": "豆瓣读书 Top250 TypeScript 爬虫与 pandas 数据清洗分析示例",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "fetch:test": "npm run build && node dist/src/fetch-check.js",
    "crawl": "npm run build && node dist/src/cli.js",
    "analyze": "bash analysis/run_analysis.sh",
    "pipeline": "npm run crawl && npm run analyze",
    "test:python": "bash analysis/run_python.sh -m unittest discover -s tests -p 'test_*.py'",
    "test:all": "npm test && npm run test:python",
    "agent": "npm run build && node dist/src/agent-cli.js",
    "agent:demo": "npm run build && node dist/src/agent-cli.js --demo",
    "recommend": "bash analysis/run_python.sh analysis/recommend.py",
    "dashboard": "bash analysis/run_python.sh dashboard/generate_dashboard.py",
    "dashboard:serve": "bash analysis/run_python.sh -m http.server 8000 --directory dashboard"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3"
  },
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zws2005/douban-top250-crawler.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zws2005/douban-top250-crawler/issues"
  },
  "homepage": "https://github.com/zws2005/douban-top250-crawler#readme"
}
